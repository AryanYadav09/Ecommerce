# ==============================================================================
# Environment Configuration (.env.example)
# Template for environment configuration across all services
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Server & Authentication
PORT=4000
JWT_SECRET=your_jwt_secret_key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# Cloudinary Media Storage
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret_key
CLOUDINARY_NAME=your_cloudinary_cloud_name

# Payment Gateways
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# MongoDB (Used for legacy data migration)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net

# Firebase Social Sign-In
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Email / OTP
RESEND_API_KEY=your_resend_api_key
OTP_EMAIL_FROM=onboarding@resend.dev

# ==============================================================================
# Primary Relational Database (Supabase PostgreSQL)
# ==============================================================================
SUPABASE_URL=https://your-project.supabase.co
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
PGHOST=db.your-project.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==============================================================================
# Python AI Microservices Mesh
# ==============================================================================
RECOMMENDATION_SERVICE_URL=http://localhost:8001
SEARCH_SERVICE_URL=http://localhost:8002

# ==============================================================================
# Headless Commerce Engine (Shopify)
# ==============================================================================
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_token
SHOPIFY_WEBHOOK_SECRET=your_webhook_hmac_secret
SHOPIFY_API_VERSION=2024-01

# ==============================================================================
# Enterprise CRM (Salesforce Service Cloud)
# ==============================================================================
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SALESFORCE_CLIENT_ID=your_connected_app_client_id
SALESFORCE_CLIENT_SECRET=your_connected_app_client_secret
SALESFORCE_USERNAME=your_salesforce_username
SALESFORCE_PASSWORD=your_salesforce_password
SALESFORCE_SECURITY_TOKEN=your_salesforce_security_token
SALESFORCE_API_VERSION=v59.0
